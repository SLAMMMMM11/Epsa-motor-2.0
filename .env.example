# Copia este archivo como .env y rellena los valores.
# .env está en .gitignore: nunca se sube al repositorio.
#
# En producción estas variables se configuran en el panel de Netlify
# (Site configuration -> Environment variables), no en un archivo.

# --- Servidor: nunca llegan al navegador ---

# Clave de Gemini para el asesor digital (/api/chat).
# Se obtiene en https://aistudio.google.com/apikey
GEMINI_API_KEY="MI_CLAVE_DE_GEMINI"

# Proyecto de Supabase donde se registran los leads (/api/leads).
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Clave service_role de Supabase. Salta el RLS y lee toda la base de datos:
# tratarla como una contraseña de administrador.
SUPABASE_SERVICE_ROLE_KEY="MI_SERVICE_ROLE_KEY"

# Token para leer los leads con GET /api/leads. Sin él, ese endpoint
# responde 401 siempre, que es el comportamiento por defecto deseado.
BOOKINGS_ADMIN_TOKEN="UNA_CADENA_LARGA_Y_ALEATORIA"

# --- Navegador: el prefijo VITE_ las incluye en el bundle ---
# No poner aquí ningún secreto: cualquiera puede leerlas en el navegador.

# Identificador de medición de Google Analytics 4 (G-XXXXXXX).
# Si se deja vacía, no se carga nada de analítica y el código se elimina
# del bundle al compilar.
VITE_GA_ID=""
